%% Instructions
% step 1 - fix everything in the set and load files
% step 2 - decide which calc to do (single, Na/Nd sweep, dopant sweep)
% step 3 - set saving terms if you want to auto save figures


% GaN - these call scripts of the same name.  Edit them to control the desired calculation
KROGER_Load_GaN_Database_and_Calc_Settings
KROGER_Set_GaN_Thermo_Conditions  % this includes temperature vector so it needs to come before material and defects
KROGER_Set_GaN_Material_Conditions
KROGER_Set_GaN_Defect_Conditions

%% Set controls (dopant sweep) Three calc commands (single, Na/Nd sweep, dopant sweep)

master.calc_command_flag = 'single';
% master.calc_command_flag = 'Na/Nd sweep';
% master.calc_command_flag = 'dopant sweep';

% Single (Here you can set these often changed values instead of checking
% multiple scripts)
conditions.Nd = 0;
conditions.Na = 1e16;
conditions.mu_conditions_flag ='Ga-rich';

% Na/Nd sweep
if strcmp(master.calc_command_flag, 'Na/Nd sweep')
    master.N_sweep = [1e15 1e16 1e17 1e18 1e19];
    master.num_N_sweep = numel(master.N_sweep);
    master.N_sweep_flag = 'Na';
end

% dopant sweep (this does not substitute fixing the element in the
% thermo_conditions file)
if strcmp(master.calc_command_flag, 'dopant sweep')
    master.dopant_to_sweep_number = 5; % Ga N C Si Mg Ge O Be Zn Ca Cd H
    master.dopant_sweep = [1e15 1e16 1e17 1e18];
    master.num_dopant_sweep = numel(master.dopant_sweep);
end
%% Set saving terms
master.auto_save_figures_flag = 'on';
master.auto_save_conditions_flag = 'on';
master.save_root = '/Users/mr.coolguymilo/Desktop/Scarpulla Lab Work/GaN Matlab Scripts/The ones Scarp revised/Calcs/TESTING MASTER SAVE TECH';
master.auto_save_figures = [2, 3];
%% Run Calcs
if (strcmp(master.calc_command_flag, 'single'))
    calc_single(conditions, defects, master)
elseif (strcmp(master.calc_command_flag, 'Na/Nd sweep'))
    calc_N_sweep(conditions, defects, master)
elseif (strcmp(master.calc_command_flag, 'dopant sweep'))
    calc_dopant_sweep(conditions, defects, master)
else
    error('select a calc command')
end

%%%%%%%%%%%%% End of Main %%%%%%%%%%%%%%%

%%%%%%%%%%%%% Subroutines %%%%%%%%%%%%%%%

function calc_single(conditions, defects, master)
[equilib_dark_sol] = defect_equilibrium_dark(conditions, defects);
KROGER_Save_Full_Equlibrium_Outputs

[fullquench_dark_sol] = defect_fullquench_dark(equilib_dark_sol, conditions, defects);
KROGER_Save_Full_Quench_Outputs

KROGER_Plot_Outputs
drawnow
save_selected(conditions, defects, master)
end

function calc_N_sweep(conditions, defects, master)
for abc = 1:master.num_N_sweep

    if strcmp(master.N_sweep_flag, 'Na')
        conditions.Na = master.N_sweep(abc);
    elseif strcmp(master.N_sweep_flag, 'Nd')
        conditions.Nd = master.N_sweep(abc);
    else
        error('when doing Na/Nd sweep you must flag either Na or Nd')
    end

    [equilib_dark_sol] = defect_equilibrium_dark(conditions, defects);
    KROGER_Save_Full_Equlibrium_Outputs

    [fullquench_dark_sol] = defect_fullquench_dark(equilib_dark_sol, conditions, defects);
    KROGER_Save_Full_Quench_Outputs

    KROGER_Plot_Outputs
    drawnow
    save_selected(conditions, defects, master)
    pause

end
end

function calc_dopant_sweep(conditions, defects, master)
for abc = 1:master.num_dopant_sweep

    conditions.fixed_conc_values(master.dopant_to_sweep_number) = master.dopant_sweep(abc);

    [equilib_dark_sol] = defect_equilibrium_dark(conditions, defects);
    KROGER_Save_Full_Equlibrium_Outputs

    [fullquench_dark_sol] = defect_fullquench_dark(equilib_dark_sol, conditions, defects);
    KROGER_Save_Full_Quench_Outputs

    KROGER_Plot_Outputs
    drawnow
    save_selected(conditions, defects, master)
    pause

end
end

function save_selected(conditions, defects, master)
[basename, basepath] = create_name_and_path(conditions, defects, master);

if strcmp(master.auto_save_figures_flag, 'on')
    master.figs = findall(0,'Type','figure');
    for a = master.auto_save_figures
        figname = sprintf('fig%d_%s.png', a, basename);
        filepath = fullfile(basepath, figname);
        exportgraphics(master.figs(a), filepath);
    end
end

if strcmp(master.auto_save_conditions_flag, 'on')
    conditions_name = sprintf('%s_conditions.mat', basename);
    filepath = fullfile(basepath, conditions_name);
    save(filepath, 'conditions')
end

end

function [basename, basepath] = create_name_and_path(conditions, defects, master)
dopant_string = "";
if strcmp(master.calc_command_flag, 'dopant sweep')
    for i = 1:length(defects.elementnames)
        val = conditions.fixed_conc_values(i);
        if val > 0 && i ~= master.dopant_to_sweep_number
            element = defects.elementnames(i);
            label = strrep(sprintf('%s%.0e', element, val), '+','');
            dopant_string = dopant_string + "_" + label;
        end
    end
else
    for i = 1:length(defects.elementnames)
        val = conditions.fixed_conc_values(i);
        if val > 0
            element = defects.elementnames(i);
            label = strrep(sprintf('%s%.0e', element, val), '+','');
            dopant_string = dopant_string + "_" + label;
        end
    end
end

if conditions.Na > 0
    N_label = strrep(sprintf('Na%.0e', conditions.Na), '+','');
elseif conditions.Nd > 0
    N_label = strrep(sprintf('Nd%.0e', conditions.Nd), '+','');
else
    N_label = "N0";
end

save_folder = fullfile(master.save_root, N_label);

if ~exist(save_folder, 'dir')
    mkdir(save_folder)
end

if strcmp(master.calc_command_flag, 'dopant sweep')
    sweep_label = sprintf('%s_sweep_%.0e', defects.elementnames(master.dopant_to_sweep_number), conditions.fixed_conc_values(master.dopant_to_sweep_number));
    basename = sprintf('%s_%s_%s_%s', conditions.mu_conditions_flag, N_label, dopant_string, sweep_label);
else
    basename = sprintf('%s_%s_%s', conditions.mu_conditions_flag, N_label, dopant_string);
end
basepath = save_folder;

end
